generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  password      String // bcrypt hash
  role          String        @default("user") // "user" | "admin" | "developer"
  emailVerified DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  chatSessions  ChatSession[]
  userMemories  UserMemory[]
}

model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory    String
  createdAt DateTime @default(now())
}

model ChatSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New chat")
  messages  Json     @default("[]") // serialized UIMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id String @id @default(cuid())

  docketNumber       String   @unique
  partyName          String
  contractNo         String[] @default([])
  selectedContractNo String[] @default([])
  enquiryDate        DateTime

  enquiryType         String?
  state               String?
  paymentTerms        String?
  inspection          String?
  pbg                 String?
  utility             String?
  vaPercent           Float?
  orderStatus         String?
  closureStatus       String?
  projectReference    String?
  apm                 String?
  offerPdfGeneratedAt DateTime?
  offerPdfGeneratedBy String?
  emailAddress        String?
  contactNo           String?

  attachments Attachment[]
  items       EnquiryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  name      String
  url       String
  type      String?
  size      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EnquiryItem {
  id String @id @default(cuid())

  enquiryId String
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  itemName String
  quantity Decimal

  itemType             String?
  moc                  String?
  itemTypeSource       String?
  mocSource            String?
  size                 String?
  sizeAndHeight        String?
  pnRating             String?
  erpItemCode          String?
  operationType        String?
  extension            String?
  bypass               String?
  others               String[] @default([])
  productCost          Decimal?
  costRefCode          String?
  cost                 Decimal?
  stockStatus          String?
  discount             Decimal?
  vaPercent            String?
  quotedRate           String?
  bomId                String?
  bomType              String? //(stores "DIRECT M2M")
  rmItemCode           String? //(the CONSUMPTION-1 rm code, for traceability)
  rmType               String?  @default("COMMON")
  contractReviewRate   String?
  pdcostValidation     String?
  quotedRateGst        String?
  itemNameMerge        String?
  totalValue           String?
  deliverySchedule     String?
  itemWiseTotalValue   String?
  itemStatus           String?
  availableBomIds      String[] @default([])
  position             Int      @default(0)
  validation           String?
  stockQuantity        String?
  costLogic            String?
  availableStock       String?
  stockAgainstContract String?
  importedInhouse      String?
  // Hidden data carrier. Drives the "C" chip beside the item code in the UI;
  // never rendered as its own column.
  cBatch               String?
  // Hidden data carrier. Drives the "Deleted as Current Reqt = No" label and the
  // deleted-status filter beside the item code in the quotation dashboard.
  nBatch               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GmdItemCode {
  id          String   @id @default(cuid())
  itemCode    String // "Code for The Item" column
  itemType    String // ITEM TYPE (col 19)
  moc         String // MOC (col 20)
  operation   String // OPERATION (col 21)
  size        String // SIZE (col 22)
  pnGmd       String // PN-GMD (col 24)
  // Hidden data carrier. Drives the "C" chip beside the item code in the UI;
  // never rendered as its own column.
  cBatch      String?
  currentReqt String?
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([itemType, moc, operation, size, pnGmd])
}

model ExtensionCost {
  id        String   @id @default(cuid())
  length    String   @unique
  cost      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BypassCost {
  id        String   @id @default(cuid())
  size      String   @unique
  cost      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentTermsCost {
  id        String   @id @default(cuid())
  terms     String   @unique
  costPct   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InspectionCost {
  id        String   @id @default(cuid())
  type      String   @unique
  costPct   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PbgCost {
  id        String   @id @default(cuid())
  pbg       String   @unique
  costPct   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TransportationCost {
  id        String   @id @default(cuid())
  state     String   @unique
  fullLoad  String
  partLoad  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupplyHistoryItem {
  id                             String   @id @default(cuid())
  financialYear                  String?
  partyName                      String?
  erpPartyName                   String?
  itemName                       String
  invoiceNo                      String
  date                           String?
  partyOrderNo                   String?
  partyDate                      String?
  quantity                       String?
  uom                            String?
  value                          String?
  grossTotalInvoiceValue         String?
  lrNoDt                         String?
  deliveryDestination            String?
  consigneeAddress               String?
  consigneeName                  String?
  erpContractNo                  String?
  erpItemCode                    String?
  typeOfValve                    String?
  sizeOfValve                    String?
  classOfValve                   String?
  sparesType                     String?
  moc                            String?
  orderCopy                      String?
  invoice                        String?
  inspectionReport               String?
  state                          String?
  utility                        String?
  performanceCertificate         String?
  servicePeriodComplete          String?
  warrantyValidTillAsPerContract String?
  warrantyValidNot               String?
  bgNo                           String?
  pbgValidTill                   String?
  asPerOrderWarrantyPeriod       String?
  pbgClaimTill                   String?
  pbgAmount                      String?
  warrantyExpDateAsPerInv        String?
  partyMailAddress               String?
  orderList                      String?
  derivedItemType                String?
  derivedMoc                     String?
  derivedSize                    String?
  // Hidden data carrier. Drives the "C" chip beside the item code in the UI;
  // never rendered as its own column.
  cBatch                         String?
  syncedAt                       DateTime @default(now())
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  @@unique([invoiceNo, itemName])
}

model GMDUpdateItem {
  id                String   @id @default(cuid())
  erpItemCode       String?
  itemNameAuto      String?
  itemNameDerived   String?
  l1                String?
  l2ValveType       String?
  l3Dia             String?
  l7Dimension       String?
  l4Component       String?
  l5Material        String?
  l6Std             String?
  l8ItemCategory    String?
  um                String?
  conv1             String?
  pcsWgt            String?
  aum               String?
  availableStock    String?
  cost              String?
  usdRateOption     String?
  hsnCode           String?
  hsnCodeValidation String?
  conv2             String?
  majorMarking      String?
  newItemStatus     String?
  currentStatus     String?
  rmType            String?
  indianImported    String?
  bomId             String?
  transferred       Boolean  @default(false)
  vendorReference   String?
  // Added by migration 20260831125743_add_availablebomid but was never declared
  // here, so the generated client silently lacked it. Declared to match the DB.
  attachmentUrl     String?
  orderDelivery     String?
  // Hidden data carrier. Drives the "C" chip beside the item code in the UI;
  // never rendered as its own column.
  cBatch            String?
  syncedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RawMaterial {
  id                String   @id @default(cuid())
  erpItemCode       String?  @unique
  itemNameAuto      String?
  itemNameDerived   String?
  l1                String?
  l2ValveType       String?
  l3Dia             String?
  l7Dimension       String?
  l4Component       String?
  l5Material        String?
  l6Std             String?
  l8ItemCategory    String?
  um                String?
  conv1             String?
  pcsWgt            String?
  aum               String?
  availableStock    String?
  cost              Decimal?
  usdRateOption     String?
  hsnCode           String?
  hsnCodeValidation String?
  conv2             String?
  majorMarking      String?
  newItemStatus     String?
  currentStatus     String?
  rmType            String?
  indianImported    String?
  transferred       Boolean  @default(false)
  vendorReference   String?
  attachmentUrl     String?
  orderDelivery     String?
  cBatch            String?

  // BOMs where this RawMaterial is used as a component
  bomComponents BomItem[]

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FullItem {
  id                   String   @id @default(cuid())
  itemCode             String?  @unique
  itemName             String?
  itemScheduleName     String?
  itemType             String?
  moc                  String?
  operation            String?
  size                 String?
  no                   String?
  pnGmd                String?
  cost                 Decimal?
  currentReqt          String?
  merged               String?
  duplicateMergerCount String?
  bomNature            String?
  consumption1         String?
  consumption2         String?
  consumption3         String?

  // BOMs belonging to this FullItem
  boms Bom[] @relation("FullItemBoms")

  // Where this FullItem itself is used as a BOM component
  bomComponents BomItem[] @relation("FullItemAsComponent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bom {
  id        String   @id @default(cuid())
  bomId     String   @unique
  bomIdType String?
  bomCost   Decimal?

  // The FullItem this BOM belongs to
  fullItemId String
  fullItem   FullItem @relation("FullItemBoms", fields: [fullItemId], references: [id])

  // Materials / FullItems consumed by this BOM
  components BomItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullItemId])
}

model BomItem {
  id String @id @default(cuid())

  bomId String
  bom           Bom          @relation(fields: [bomId],references: [id], onDelete: Cascade)

  // If this component is a RawMaterial
  rawMaterialId String?
  rawMaterial   RawMaterial? @relation(fields: [rawMaterialId], references: [id])

  // If this component is another FullItem
  fullItemId String?
  fullItem   FullItem? @relation("FullItemAsComponent", fields: [fullItemId], references: [id])

  // Component-specific fields
  quantity Int?
  cost     Decimal?
  noUse    String?
  cBatch   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bomId])
  @@index([rawMaterialId])
  @@index([fullItemId])
}

model VerifyBom {
  id                   String   @id @default(cuid())
  bomId                String
  itemCode             String
  rmItemCode           String
  bomIdType            String?
  bomItemQty           String?
  noUse                String?
  cBatch               String?
  availableStock       String?
  itemName             String?
  itemScheduleName     String?
  rmItemName           String?
  itemType             String?
  moc                  String?
  operation            String?
  size                 String?
  no                   String?
  pnGmd                String?
  currentReqt          String?
  merged               String?
  duplicateMergerCount String?
  bomNature            String?
  consumption1         String?
  consumption2         String?
  consumption3         String?
  cost                 String?
  bomItemQtyCost       String?
  syncedAt             DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([bomId, itemCode, rmItemCode])
  @@index([itemCode])
}

model ContractReview {
  id                               String   @id @default(cuid())
  contractNo                       String
  itemCode                         String
  mcNo                             String?
  itemName                         String?
  partyItemName                    String?
  rate                             String?
  cv                               String?
  vaPercent                        String?
  orderQty                         String?
  freeStock                        String?
  finalReq                         String?
  mcQty                            String?
  balanceMc                        String?
  prodOrdQty                       String?
  balanceToProdOrd                 String?
  balanceToProdEnt                 String?
  diQty                            String?
  billedQty                        String?
  balBillAgMc                      String?
  balBillAgCont                    String?
  item                             String?
  value                            String?
  size                             String?
  pnRating                         String?
  dateOfContract                   String?
  clearanceStatus                  String?
  actuator                         String?
  rmCodeForActuator                String?
  rmCodeForGb                      String?
  paymentTerms                     String?
  lcRtgsRefNo                      String?
  lcDateRtgsDate                   String?
  lastDateOfShipmentDateOfLc       String?
  issuingBankName                  String?
  bomFormulaTrial                  String?
  erpPartyNameFromGmdSupplyHistory String?
  itemType                         String?
  jobCode                          String?
  balDiQty                         String?
  balMcVal                         String?
  balProdOrdVal                    String?
  balToProdOrdEntVal               String?
  balBillAgMcVal                   String?
  balBillAgContVal                 String?
  balDiVal                         String?
  state                            String?
  utility                          String?
  projectReference                 String?
  diVal                            String?
  icQty                            String?
  bomId                            String?
  noUse                            String?
  partyNameDump                    String?
  status                           String?
  mcReceivedPending                String?
  inspection                       String?
  offerPendingDone                 String?
  remarks                          String?
  costCodeRef                      String?
  offerNumber                      String[] @default([])
  inspectionNumber                 String[] @default([])
  diDate                           String[] @default([])
  costfromQuotation                String?
  vaPercentfromcost                String?
  productionOrderNumber            String?
  diagramUrl                       String?
  diagramVerdict                   String?
