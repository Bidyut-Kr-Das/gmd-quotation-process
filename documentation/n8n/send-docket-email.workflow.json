      "parameters": {
        "jsCode": "// Reply needs the id of a message in the thread; use the newest one.\n// Carry the webhook form body and the attachment binary forward.\nconst webhook = $('Webhook').first();\nconst items = $input.all();\nconst last = items.length ? items[items.length - 1].json : {};\nreturn [{\n  json: { messageId: last.id, body: webhook.json.body },\n  binary: webhook.binary,\n}];"
      },
